{{!< default}}

<div class="cyber-error-page">
  <div class="cyber-container">
    <div class="error-hud-box">
      <span class="hud-corner top-left" aria-hidden="true"></span>
      <span class="hud-corner top-right" aria-hidden="true"></span>
      <span class="hud-corner bottom-left" aria-hidden="true"></span>
      <span class="hud-corner bottom-right" aria-hidden="true"></span>

      <h1 class="error-big-code glitch-text" data-text="404">404</h1>
      <h2 class="error-title">Page not found</h2>

      <p class="error-desc">
        The page you are looking for does not exist or has been moved.
      </p>

      <div class="error-actions">
        <a class="cyber-btn cyber-btn-primary" href="{{@site.url}}">
          <span class="btn-chamfer"></span>
          <span class="btn-text">Back to home</span>
        </a>
      </div>
    </div>

    {{#get "posts" limit="3" as |recent_posts|}}
      {{#if recent_posts}}
        <div class="error-recent-section">
          <h3 class="recent-title">Recent posts</h3>
          <div class="cyber-grid">
            {{#foreach recent_posts}}
              {{> "post-card"}}
            {{/foreach}}
          </div>
        </div>
      {{/if}}
    {{/get}}
  </div>
</div>
