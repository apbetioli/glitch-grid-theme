<article class="cyber-card {{post_class}}{{#if featured}} is-featured{{/if}}{{#unless feature_image}} no-image{{/unless}}">
  <div class="cyber-card-frame">
    {{#if feature_image}}
      <a class="cyber-card-media" href="{{url}}" tabindex="-1" aria-hidden="true">
        <div class="media-overlay"></div>
        <img
          class="cyber-card-img"
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          src="{{img_url feature_image size="m"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
          loading="lazy"
        />
        {{#if featured}}
          <span class="cyber-badge badge-featured">Featured</span>
        {{/if}}
      </a>
    {{/if}}

    <div class="cyber-card-body">
      <div class="cyber-card-meta-top">
        {{#primary_tag}}
          <a class="cyber-tag" href="{{url}}">{{name}}</a>
        {{/primary_tag}}
        <span class="cyber-reading-time">{{reading_time}}</span>
      </div>

      <h2 class="cyber-card-title">
        <a href="{{url}}" class="cyber-card-link glitch-hover-sm" data-text="{{title}}">
          {{title}}
        </a>
      </h2>

      {{#if excerpt}}
        <p class="cyber-card-excerpt">
          {{excerpt words="26"}}...
        </p>
      {{/if}}

      <div class="cyber-card-footer">
        <div class="author-block">
          {{#foreach authors}}
            {{#if profile_image}}
              <a href="{{url}}" class="author-avatar-link" aria-label="{{name}}">
                <img class="author-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy" />
              </a>
            {{/if}}
          {{/foreach}}
          <div class="author-info">
            <span class="author-name">{{authors}}</span>
            <time class="post-date" datetime="{{date format="YYYY-MM-DD"}}">
              {{date format="YYYY-MM-DD"}}
            </time>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
