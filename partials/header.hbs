<header class="cyber-header" id="cyber-header">
  <div class="cyber-navbar">
    <div class="cyber-container nav-container">
      <div class="nav-brand-wrap">
        {{#if @site.logo}}
          <a class="cyber-logo" href="{{@site.url}}">
            <img src="{{@site.logo}}" alt="{{@site.title}}" />
          </a>
        {{else}}
          <a class="cyber-site-title glitch-hover" href="{{@site.url}}" data-text="{{@site.title}}">
            <span class="cyber-title-text">{{@site.title}}</span>
          </a>
        {{/if}}
      </div>

      <nav class="cyber-menu" id="cyber-menu" aria-label="Main Navigation">
        {{navigation}}
      </nav>

      <div class="nav-actions">
        {{!-- Ghost Native Search button --}}
        <button class="cyber-icon-btn search-trigger" data-ghost-search aria-label="Search posts">
          {{> "icons/search"}}
          <span class="sr-only">Search</span>
        </button>

        {{!-- Membership / Portal integration --}}
        {{#if @site.members_enabled}}
          {{#if @member}}
            <a class="cyber-btn cyber-btn-ghost" href="#/portal/account" data-portal="account">
              <span class="btn-chamfer"></span>
              <span class="btn-text">Account</span>
            </a>
          {{else}}
            <a class="cyber-btn cyber-btn-ghost hide-mobile" href="#/portal/signin" data-portal="signin">
              <span class="btn-chamfer"></span>
              <span class="btn-text">Sign in</span>
            </a>
            <a class="cyber-btn cyber-btn-primary" href="#/portal/signup" data-portal="signup">
              <span class="btn-chamfer"></span>
              <span class="btn-glow"></span>
              <span class="btn-text">Subscribe</span>
            </a>
          {{/if}}
        {{/if}}

        <button class="cyber-burger" id="burger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="cyber-menu">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </button>
      </div>
    </div>
  </div>
</header>
