{{!< default}}

{{#post}}
<article class="cyber-article {{post_class}}">
  <div class="cyber-article-header">
    <div class="cyber-container-article">
      <div class="article-meta-top">
        <a class="cyber-back-link" href="{{@site.url}}">
          {{> "icons/arrow-left"}}
          <span>Back</span>
        </a>
        <div class="article-tags">
          {{#foreach tags}}
            <a class="cyber-tag" href="{{url}}">{{name}}</a>
          {{/foreach}}
        </div>
      </div>

      <h1 class="article-title glitch-hover" data-text="{{title}}">
        {{title}}
      </h1>

      {{#if custom_excerpt}}
        <p class="article-lead">
          {{custom_excerpt}}
        </p>
      {{/if}}

      <div class="article-meta-bar">
        <div class="article-author-meta">
          {{#foreach authors}}
            {{#if profile_image}}
              <img class="author-avatar-sm" src="{{img_url profile_image size="xs"}}" alt="{{name}}" />
            {{/if}}
          {{/foreach}}
          <div class="author-details">
            <span class="author-name-text">{{authors}}</span>
            <div class="article-sub-meta">
              <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="YYYY-MM-DD"}}</time>
              <span class="meta-dot">&bull;</span>
              <span>{{reading_time}}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{#if feature_image}}
    <figure class="article-feature-image-wrap cyber-container">
      <div class="feature-image-frame">
        <img
          class="article-feature-image"
          srcset="{{img_url feature_image size="s"}} 300w,
                  {{img_url feature_image size="m"}} 600w,
                  {{img_url feature_image size="l"}} 1000w,
                  {{img_url feature_image size="xl"}} 2000w"
          sizes="(max-width: 1000px) 100vw, 1000px"
          src="{{img_url feature_image size="xl"}}"
          alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        />
      </div>
      {{#if feature_image_caption}}
        <figcaption class="feature-image-caption">
          {{{feature_image_caption}}}
        </figcaption>
      {{/if}}
    </figure>
  {{/if}}

  <div class="cyber-container-article">
    {{#if access}}
      {{!-- Full Post Content --}}
      <section class="cyber-content gh-content">
        {{{content}}}
      </section>

      {{!-- Post Author Bio Card --}}
      <div class="author-cyber-card">
        {{#foreach authors}}
          <div class="author-card-inner">
            {{#if profile_image}}
              <img class="author-card-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" />
            {{/if}}
            <div class="author-card-content">
              <h3 class="author-card-name"><a href="{{url}}">{{name}}</a></h3>
              {{#if bio}}
                <p class="author-card-bio">{{bio}}</p>
              {{/if}}
              <div class="author-card-links">
                {{#if website}}
                  <a class="author-ext-link" href="{{website}}" target="_blank" rel="noopener">Website</a>
                {{/if}}
                {{#if twitter}}
                  <a class="author-ext-link" href="{{social_url type="twitter"}}" target="_blank" rel="noopener">Twitter</a>
                {{/if}}
                {{#if facebook}}
                  <a class="author-ext-link" href="{{social_url type="facebook"}}" target="_blank" rel="noopener">Facebook</a>
                {{/if}}
              </div>
            </div>
          </div>
        {{/foreach}}
      </div>

      {{!-- Ghost Native Comments --}}
      {{#if comments}}
        <section class="cyber-comments-section">
          <div class="comments-header">
            <h3 class="comments-title">Comments</h3>
          </div>
          <div class="comments-container">
            {{comments}}
          </div>
        </section>
      {{/if}}

    {{else}}
      {{!-- Restricted Access Paywall Gate --}}
      <div class="cyber-gate-lockdown">
        <div class="lockdown-frame">
          <div class="lockdown-icon">
            {{> "icons/lock"}}
          </div>

          <h2 class="lockdown-title">This post is for subscribers only</h2>
          <p class="lockdown-desc">
            Sign up to read the full story and get access to all members-only content.
          </p>

          <div class="lockdown-actions">
            <a class="cyber-btn cyber-btn-primary" href="#/portal/signup" data-portal="signup">
              <span class="btn-chamfer"></span>
              <span class="btn-text">Subscribe</span>
            </a>
            <a class="cyber-btn cyber-btn-ghost" href="#/portal/signin" data-portal="signin">
              <span class="btn-chamfer"></span>
              <span class="btn-text">Sign in</span>
            </a>
          </div>
        </div>
      </div>
    {{/if}}
  </div>

  {{!-- Prev / Next Navigation --}}
  <nav class="cyber-post-nav">
    <div class="cyber-container-article post-nav-inner">
      {{#prev_post}}
        <a class="post-nav-card post-nav-prev" href="{{url}}">
          <span class="nav-direction">&lt; Previous post</span>
          <span class="nav-post-title">{{title}}</span>
        </a>
      {{/prev_post}}

      {{#next_post}}
        <a class="post-nav-card post-nav-next" href="{{url}}">
          <span class="nav-direction">Next post &gt;</span>
          <span class="nav-post-title">{{title}}</span>
        </a>
      {{/next_post}}
    </div>
  </nav>

  {{!-- Related Posts Feed --}}
  {{#if primary_tag}}
    {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="3" as |related_posts|}}
      {{#if related_posts}}
        <section class="cyber-related-section">
          <div class="cyber-container">
            <div class="related-header">
              <h3 class="related-title">Related posts</h3>
            </div>
            <div class="cyber-grid">
              {{#foreach related_posts}}
                {{> "post-card"}}
              {{/foreach}}
            </div>
          </div>
        </section>
      {{/if}}
    {{/get}}
  {{/if}}
</article>
{{/post}}
