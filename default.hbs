<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{meta_title}}</title>

  {{!-- Cyberpunk Typography --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Orbitron:wght@500;700;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{!-- Theme CSS --}}
  <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />

  {{#if @custom.cyber_accent_color}}
  <style>
    :root {
      --color-cyan: {{@custom.cyber_accent_color}};
    }
  </style>
  {{/if}}

  {{!-- Ghost Head --}}
  {{ghost_head}}
</head>
<body class="{{body_class}}{{#unless @custom.enable_scanlines}} scanlines-disabled{{/unless}}">
  {{!-- Ambient Cyberpunk Visual Layers --}}
  <div class="cyber-bg-grid" id="cyber-bg-grid" aria-hidden="true"></div>
  <div class="cyber-scanlines" id="cyber-scanlines" aria-hidden="true"></div>
  <div class="cyber-crt-vignette" aria-hidden="true"></div>
  <div class="cyber-reading-bar" id="cyber-reading-bar" aria-hidden="true"></div>

  {{!-- Skip Navigation link for a11y --}}
  <a class="cyber-skip-link" href="#main-content">SKIP TO NEURAL FEED</a>

  <div class="cyber-site-wrap">
    {{> "header"}}

    <main id="main-content" class="cyber-main-content">
      {{{body}}}
    </main>

    {{> "footer"}}
  </div>

  {{!-- Theme Scripts --}}
  <script src="{{asset "js/main.js"}}"></script>

  {{!-- Ghost Foot --}}
  {{ghost_foot}}
</body>
</html>
