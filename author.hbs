{{!< default}}

{{#author}}
<div class="cyber-author-page">
  <header class="cyber-author-header">
    <div class="cyber-container">
      <div class="author-hud-profile">
        <span class="hud-corner top-left" aria-hidden="true"></span>
        <span class="hud-corner top-right" aria-hidden="true"></span>
        <span class="hud-corner bottom-left" aria-hidden="true"></span>
        <span class="hud-corner bottom-right" aria-hidden="true"></span>

        <div class="author-profile-grid">
          {{#if profile_image}}
            <div class="author-profile-img-wrap">
              <img class="author-profile-img" src="{{img_url profile_image size="m"}}" alt="{{name}}" />
              <div class="img-glow-ring"></div>
            </div>
          {{/if}}

          <div class="author-profile-bio-wrap">
            <div class="author-hud-meta">
              <span class="status-pulse-dot"></span>
              <span class="author-role-label">OPERATIVE_RECORD // AGENT_FILE</span>
            </div>

            <h1 class="author-profile-name glitch-text" data-text="{{name}}">{{name}}</h1>

            {{#if bio}}
              <p class="author-profile-desc">{{bio}}</p>
            {{/if}}

            <div class="author-profile-tags">
              {{#if location}}
                <span class="author-meta-pill">LOC: {{location}}</span>
              {{/if}}
              <span class="author-meta-pill">
                RECORDS: {{plural ../pagination.total empty="0 TRANSMISSIONS" singular="1 TRANSMISSION" plural="% TRANSMISSIONS"}}
              </span>
            </div>

            <div class="author-profile-links">
              {{#if website}}
                <a class="cyber-btn cyber-btn-ghost-sm" href="{{website}}" target="_blank" rel="noopener">WEBSITE</a>
              {{/if}}
              {{#if twitter}}
                <a class="cyber-btn cyber-btn-ghost-sm" href="{{social_url type="twitter"}}" target="_blank" rel="noopener">TWITTER</a>
              {{/if}}
              {{#if facebook}}
                <a class="cyber-btn cyber-btn-ghost-sm" href="{{social_url type="facebook"}}" target="_blank" rel="noopener">FACEBOOK</a>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="cyber-feed-section">
    <div class="cyber-container">
      <div class="cyber-grid">
        {{#foreach ../posts}}
          {{> "post-card"}}
        {{/foreach}}
      </div>

      {{pagination}}
    </div>
  </section>
</div>
{{/author}}
